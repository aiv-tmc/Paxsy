/*
 * Combines several standard library modules to demonstrate:
 *   - `std::list` (dynamic array of pointers)
 *   - `std::map` (hash table)
 *   - `std::time` for timing
 *   - `std::string` for parsing
 */

use std::inout;
use std::list;
use std::map;
use std::time;
use std::string;

/* Comparator for integers (as pointers) */
func cmp_int_ptr(a: &Void, b: &Void): Int32 {
    let ia: &Int32 = a as &Int32;
    let ib: &Int32 = b as &Int32;
    return @ia - @ib;
}

/* Hash and equality for map (integer keys) */
func hash_int(k: &Void): UInt64 {
    let v: &Int32 = k as &Int32;
    return @v as UInt64;
}
func eq_int(a: &Void, b: &Void): Bool {
    let ia: &Int32 = a as &Int32;
    let ib: &Int32 = b as &Int32;
    return @ia == @ib;
}

func main(): Void {
    /* --- std::list --- */
    let lst = std::list::create(4) catch |e| {
        std::inout::println("list create failed: {e}");
        return;
    };
    defer std::list::destroy(lst);

    let val1: Int32 = 10;
    let val2: Int32 = 20;
    let val3: Int32 = 30;
    std::list::push(lst, &val1);
    std::list::push(lst, &val2);
    std::list::push_front(lst, &val3);  // front: 30, 10, 20
    std::inout::println("List size: {list::size(lst)}");
    /* Retrieve and print elements */
    for 0..(std::list::size(lst)-1) |i| {
        let p = std::list::get(lst, i);
        if p != null {
            let v: &Int32 = p as &Int32;
            std::inout::print("{@v} ");
        }
    }
    std::inout::println("");

    /* Sort list using comparator */
    std::list::sort(lst, cmp_int_ptr);
    std::inout::println("Sorted list:");
    for 0..(std::list::size(lst)-1) |i| {
        let p = std::list::get(lst, i);
        if p != null {
            let v: &Int32 = p as &Int32;
            inout::print("{@v} ");
        }
    }
    std::inout::println("");

    /* --- std::map --- */
    let m = std::map::create(hash_int, eq_int, 16) catch |e| {
        std::inout::println("map create failed: {e}");
        return;
    };
    defer std::map::destroy(m);

    let key1: Int32 = 1;
    let key2: Int32 = 2;
    let val_a: Int32 = 100;
    let val_b: Int32 = 200;
    std::map::insert(m, &key1, &val_a);
    std::map::insert(m, &key2, &val_b);

    let found = std::map::get(m, &key1);
    if found != null {
        let v: &Int32 = found as &Int32;
        std::inout::println("Map[1] = {@v}");
    }
    std::inout::println("Map size: {std::map::size(m)}");

    /* --- std::time --- */
    let start = std::time::time(null);
    /* simulate some work */
    std::time::sleep(1);
    let end = std::time::time(null);
    let elapsed = std::time::difftime(end, start);
    std::inout::println("Slept for about {elapsed} seconds");

    /* --- std::string parse --- */
    let num_str = "1234";
    let parsed = std::string::parse_int(num_str) catch |e| {
        std::inout::println("parse_int failed: {e}");
        return;
    };
    std::inout::println("Parsed '{num_str}' as {parsed}");

    let float_str = "3.14159";
    let parsed_float = std::string::parse_float(float_str) catch |e| {
        std::inout::println("parse_float failed: {e}");
        return;
    };
    std::inout::println("Parsed '{float_str}' as {parsed_float}");
}
