/*
 * Showcases compile-time evaluation:
 *   - `comptime` constants and type aliases
 *   - Compile-time functions and blocks
 *   - Using `comptime` to generate static data
 */

use std::inout;
use std::type;

/* Compile-time constant */
comptime PI = 3.14159;
comptime MAX_SIZE = 1024;
comptime T = Int32;   // type alias

/* Compile-time function */
comptime square(x: Int32): Int32 = x * x;
comptime cube(x: Int32): Int32 {
    return x * x * x;
}

/* Compile-time block that computes an array size */
comptime ARRAY_SIZE: Int32;
comptime {
    let sum = 0;
    for 0..10 |i| {
        sum += i;
    }
    ARRAY_SIZE = sum;   // 45
}

func main(): Void {
    /* Use constants */
    std::inout::println("PI = {PI}, MAX_SIZE = {MAX_SIZE}");

    /* Use type alias */
    let value: T = 100;
    std::inout::println("value (T) = {value}");

    /* Use compile-time functions */
    std::inout::println("square(5) = {square(5)}");
    std::inout::println("cube(3) = {cube(3)}");

    /* Use computed array size */
    let arr[ARRAY_SIZE]: Int32;
    std::inout::println("Array size is {arr.length}");

    /* Type introspection (compile-time) */
    std::inout::println("type_name of T: {std::type::type_name(T)}");
    std::inout::println("size_of(Int32): {std::type::size_of(Int32)}");
    std::inout::println("is_integer(Int32): {std::type::is_integer(Int32)}");
    std::inout::println("is_float(Real64): {std::type::is_float(Real64)}");

    /* Compile-time block inside function? Not needed, but we can show inline comptime */
    comptime {
        let msg = "This is evaluated at compile time.";
        /* Could generate static string, etc. */
    }
    std::inout::println("All compile-time evaluations done.");
}
