/*
 * Demonstrates lightweight processes with message passing.
 *   - Define a process using `proc`
 *   - Spawn processes with `spawn`
 *   - Send messages with `<-`
 *   - Receive with `receive` and pattern matching
 *   - Use `self` to get own PID
 */

use std::inout;
use std::time;

/* Process that acts as a counter */
proc Counter {
    let mut count: Int32 = 0;
    while true {
        receive {
            case {"get", none} |none, from| {
                from <- {"count", count, self};
            }
            case {"inc", none} |none, from| {
                count += 1;
                from <- {"ok", self};
            }
            case {"reset", none} |none, from| {
                count = 0;
                from <- {"ok", self};
            }
            else {
                std::inout::println("Counter: unknown message, stopping.");
                break;
            }
        }
    }
}

/* Process that prints any message it receives */
proc Printer {
    while true {
        receive {
            case {any, none} |msg, from| {
                std::inout::println("Printer received from {from}: {msg}");
                from <- {"printed", self};
            }
            else { break; }
        }
        std::time::sleep(100);   // small delay
    }
}

func main(): Void {
    /* Spawn processes
    let counter = spawn Counter;
    let printer = spawn Printer;

    /* Send messages to counter */
    counter <- {"inc", self};
    counter <- {"inc", self};
    counter <- {"get", self};

    /* Send a print message */
    printer <- {"Hello, processes!", self};

    /* Wait for replies */
    let mut replies_received = 0;
    while replies_received < 3 {
        receive {
            case {"count", none} |count, from| {
                std::inout::println("Main: Counter is {count} (from {from})");
                replies_received += 1;
            }
            case {"ok", none} |none, from| {
                std::inout::println("Main: OK from {from}");
                replies_received += 1;
            }
            case {"printed", none} |none, from| {
                std::inout::println("Main: Printer confirmed from {from}");
                replies_received += 1;
            }
            else {
                std::inout::println("Main: unknown message");
            }
        }
    }

    /* Cleanly terminate processes by sending a break signal (send any unrecognised message) */
    counter <- {"stop", self};
    printer <- {"stop", self};

    std::inout::println("Main exiting.");
}
