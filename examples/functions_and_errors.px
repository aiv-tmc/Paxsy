/*
 * Shows:
 *   - Function definition with parameters and return types
 *   - Single-expression function syntax
 *   - Error-carrying types (`!`) and generating errors with `error`
 *   - Propagating with `try` and handling with `catch`
 *   - `defer` for cleanup
 *   - Using `std::fs` to read a file
 */

use std::inout;
use std::fs;
use std::errno;

/* A function that may fail: returns Int32! (Int32 or error) */
func divide(a: Int32, b: Int32): Int32! {
    if b == 0 {
        return error std::errno::EINVAL;     // generate error with standard code
    }
    return a / b;
}

/* Single-expression function (no braces, implicit return) */
func square(x: Int32): Int32 = x * x;

/* Function using `try` to propagate errors; itself returns Int32! */
func safe_divide_try(a: Int32, b: Int32): Int32! {
    return try divide(a, b);
}

func main(): Void {
    /* Using divide with `catch` to handle error inline */
    let result = divide(10, 0) catch |e| {
        std::inout::println("Caught error code: {e}");
        return;
    };
    std::inout::println("result = {result}");

    let good = divide(10, 2) catch |e| {
        std::inout::println("unexpected error: {e}");
        return error 1;
    };
    std::inout::println("good = {good}");

    /* Propagating with try – we must handle error here */
    let propagated = try safe_divide_try(20, 5) catch |e| {
        std::inout::println("propagate error: {e}");
        return;
    };
    std::inout::println("propagated result = {propagated}");

    /* Using `defer` for cleanup: open a file, ensure close */
    let fd = try std::fs::open("example.txt", std::fs::O_RDONLY, 0) catch |e| {
        std::inout::println("Failed to open file: {e}");
        return;
    };
    defer std::fs::close(fd) catch { /* ignore close errors */ };

    let buffer[64]: UInt8;
    let n = try std::fs::read(fd, &buffer[0], 63) catch |e| {
        std::inout::println("Read error: {e}");
        return;
    };
    buffer[n] = 0;      // null-terminate
    std::inout::println("Read {n} bytes: {buffer as Char[]}");
}
