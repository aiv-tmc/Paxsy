/*
 * Showcases:
 *   - Module declaration (named and unnamed)
 *   - `use` directive to import symbols
 *   - Using standard library modules: `std::algor`, `std::string`, `std::math`
 *   - Using `std::inout` for I/O
 *   - Generic algorithms on arrays via `std::algor`
 */

use std::inout;
use std::algor;
use std::string;
use std::math;

/* Define a named module inside this file */
module my_math {
    func add(a: Int32, b: Int32): Int32 {
        return a + b;
    }
    func multiply(a: Int32, b: Int32): Int32 {
        return a * b;
    }
}

/* Unnamed module – everything is globally accessible within project (here, just file) */
module {
    func print_summary(x: Int32, y: Int32): Void {
        std::inout::println("my_math::add({x}, {y}) = {my_math::add(x, y)}");
        std::inout::println("my_math::multiply({x}, {y}) = {my_math::multiply(x, y)}");
    }
}

/* Comparator for `std::algor::sort` – must be a function with signature CmpFn */
func cmp_int(a: &Void, b: &Void): Int32 {
    let ia: &Int32 = a as &Int32;
    let ib: &Int32 = b as &Int32;
    return @ia - @ib;
}

func main(): Void {
    /* Using `use` to bring `std::math::sin` directly */
    use std::math::{sin, cos};
    let angle = 3.14159 / 4.0;
    std::inout::println("sin(pi/4) = {sin(angle)}, cos(pi/4) = {cos(angle)}");

    /* Using `std::string` functions */
    let text = "Hello, Paxsy!";
    let len = string::len(text);
    let upper = string::to_upper(text) catch |e| {
        std::inout::println("to_upper failed: {e}");
        return;
    };
    std::inout::println("Original: {text}, length: {len}, upper: {upper}");

    /* Using `std::algor` to sort an array */
    let mut arr[5]: Int32 = {9, 3, 7, 1, 5};
    std::algor::sort(&arr[0], 5, 4, cmp_int);
    std::inout::println("Sorted array:");
    for 0..4 |i| { std::inout::print("{arr[i]} "); }
    std::inout::println("");

    /* Using our defined modules */
    print_summary(6, 7);
}
