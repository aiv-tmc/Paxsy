/*
 * Covers:
 *   - Pointer declaration and dereferencing (`&` and `@`)
 *   - Null pointers
 *   - Using `std::memory` for dynamic allocation
 *   - Pointer casting
 *   - Volatile qualifier for memory-mapped I/O (concept)
 */

use std::inout;
use std::memory;

func main(): Void {
    /* Stack variable */
    let val: Int32 = 42;
    /* Pointer to it */
    let ptr: &Int32 = &val;
    std::inout::println("val = {val}, *ptr = {@ptr}");

    /* Modify through pointer */
    @ptr = 100;
    std::inout::println("After @ptr = 100, val = {val}");

    /* Null pointer */
    let null_ptr: &Int32 = null;
    /* Dereferencing null would cause runtime error, so check */
    if null_ptr == null {
        std::inout::println("null_ptr is null, not dereferenced.");
    }

    /* Dynamic allocation with std::memory */
    let heap_ptr = std::memory::alloc(8) catch |e| {
        std::inout::println("alloc failed: {e}");
        return;
    };
    defer std::memory::free(heap_ptr);

    /* Treat as pointer to Int32 */
    let int_ptr: &Int32 = heap_ptr as &Int32;
    @int_ptr = 1234;
    std::inout::println("Heap value: {@int_ptr}");

    /* Allocate zero-initialised array */
    let arr_ptr = std::memory::calloc(4, 2) catch |e| {
        std::inout::println("calloc failed: {e}");
        return;
    };
    defer std::memory::free(arr_ptr);
    /* Interpret as array of UInt16 (size 2 bytes each) */
    let arr16: &UInt16 = arr_ptr as &UInt16;
    for 0..3 |i| {
        std::inout::print("{arr16[i]} ");   // should be 0s
    }
    std::inout::println("");

    /* Pointer arithmetic? Not directly supported; but we can cast to &Void and compute offsets.
     * We'll just show that we can use std::memory::copy
     */
    let src[4]: Int32 = [1, 2, 3, 4];
    let dest[4]: Int32;
    std::memory::copy(&dest[0], &src[0], 16);   // 4 * 4 bytes
    std::inout::println("Copied dest: {dest[0]}, {dest[1]}, {dest[2]}, {dest[3]}");

    /* Volatile parameter demonstration (concept, not fully functional)
     * We define a function that takes a volatile pointer
     */
    func write_register(reg volatile: &Int32): Void {
        @reg = 0xDEAD;
        @reg = 0xBEEF;    // both writes preserved
    }
    let reg_val: Int32 = 0;
    write_register(&reg_val);
    std::inout::println("reg_val = {reg_val}");
}
