/*
 * Illustrates:
 *   - `comptime Struct` definition with fields
 *   - Initialisation (positional and named)
 *   - Associated functions (static methods) inside structs
 *   - `comptime Enum` with explicit values
 *   - Using enums in `match`
 */

use std::inout;

/* Define a struct */
comptime Person = Struct {
    name: Char[32],
    age: Int32,
    /* Associated function prototypes (static) */
    func extern greet(p: Person): Void,
    func extern is_adult(p: Person): Bool,
};

/* Implement the associated functions */
func greet(p: Person): Void {
    std::inout::println("Hello, my name is {p.name} and I am {p.age} years old.");
}
func is_adult(p: Person): Bool {
    return p.age >= 18;
}

/* Define an enum */
comptime Status = Enum {
    OK = 0,
    WARNING = 1,
    ERROR = 2,
    FATAL = 3,
};

func main(): Void {
    /* Struct initialisation by position */
    let alice: Person = ["Alice", 25];
    /* Struct initialisation by name (order irrelevant) */
    let bob: Person = [.name = "Bob", .age = 17];

    /* Access fields */
    std::inout::println("Alice's age: {alice.age}");
    std::inout::println("Bob's name: {bob.name}");

    /* Call associated functions using instance syntax */
    alice.greet();   // calls greet(alice)
    bob.greet();

    std::inout::println("Alice adult? {alice.is_adult()}");  // true
    std::inout::println("Bob adult? {bob.is_adult()}");      // false

    /* Enum usage */
    let state: Status = Status.WARNING;
    match state {
        case Status.OK      { std::inout::println("Everything is fine."); }
        case Status.WARNING { std::inout::println("Warning!"); }
        case Status.ERROR   { std::inout::println("Error occurred."); }
        case Status.FATAL   { std::inout::println("Fatal error!"); }
        else { std::inout::println("Unknown status."); }
    }

    /* Copying structs: value semantics */
    let charlie: Person = alice;   // copy
    charlie.name = "Charlie";
    std::inout::println("Alice is still {alice.name}, Charlie is {charlie.name}");
}
