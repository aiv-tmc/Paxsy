/*
 * Demonstrates:
 *   - Variable declarations with explicit and inferred types
 *   - Arithmetic and logical operators
 *   - `if` / `else if` / `else` and `if` as expression
 *   - `match` for discrete value branching
 *   - `while`, `do-while`, `for` loops with ranges
 *   - `break` and `continue`
 */

use std::inout;

func main(): Void {
    /* Variables and types */
    let a: Int32 = 10;
    let b = 5;                      // inferred as Int8 (since 5 fits)
    let c: Int64 = a as Int64 + b;  // explicit casting
    std::inout::println("a = {a}, b = {b}, c = {c}");

    /* Compound assignment */
    let mut x = 7;
    x += 3;
    x *= 2;
    std::inout::println("x = {x}");

    /* Comparison and logical operators */
    let cond = (a > b) and (c != 0);
    std::inout::println("cond = {cond}");

    /* if / else */
    if a > 20 {
        std::inout::println("a is large");
    } else if a > 5 {
        std::inout::println("a is medium");
    } else {
        std::inout::println("a is small");
    }

    /* if as expression */
    let max_val = if a > b { a } else { b };
    std::inout::println("max = {max_val}");

    /* match statement */
    let day = 3;
    match day {
        case 1 { std::inout::println("Monday"); }
        case 2 { std::inout::println("Tuesday"); }
        case 3 { std::inout::println("Wednesday"); }
        case 4 { std::inout::println("Thursday"); }
        case 5 { std::inout::println("Friday"); }
        case 6 { std::inout::println("Saturday"); }
        case 7 { std::inout::println("Sunday"); }
        else { std::inout::println("Invalid day"); }
    }

    /* while loop */
    let mut i = 0;
    while i < 5 {
        std::inout::print("{i} ");
        i += 1;
    }
    std::inout::println("");

    /* do-while loop (executes at least once) */
    let mut j = 10;
    do {
        std::inout::print("{j} ");
        j -= 1;
    } while j > 5;
    std::inout::println("");

    /* for loop over range (inclusive) */
    for 0..4 |idx| {
        std::inout::print("{idx} ");
    }
    std::inout::println("");

    /* for with explicit type and continue/break */
    for 0..10 |k: Int32| {
        if k % 2 == 0 { continue; }   // skip even numbers
        if k > 7 { break; }           // stop at 9 (since 8 even skipped, break after 7)
        std::inout::print("{k} ");
    }
    std::inout::println("");

    /* loop labels */
    outer: for 0..5 |i| {
        for 0..5 |j| {
            if i * j > 6 {
                std::inout::println("breaking outer at i={i}, j={j}");
                break outer;
            }
        }
    }
}
