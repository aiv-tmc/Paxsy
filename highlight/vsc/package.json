{
  "name": "paxsy",
  "displayName": "Paxsy Language Support",
  "description": "Syntax highlighting and language support for Paxsy",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "paxsy",
        "aliases": ["Paxsy", "paxsy"],
        "extensions": [".px"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "paxsy",
        "scopeName": "source.paxsy",
        "path": "./syntaxes/paxsy.tmLanguage.json"
      }
    ]
  }
}
