{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Paxsy",
  "scopeName": "source.paxsy",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.paxsy",
          "match": "//.*$"
        },
        {
          "name": "comment.block.paxsy",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "comment.block.paxsy",
              "match": "."
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.paxsy",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.paxsy",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.paxsy",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            }
          ]
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.paxsy",
          "match": "\\b(0b[01][01_]*|0o[0-7][0-7_]*|0x[0-9A-Fa-f][0-9A-Fa-f_]*|[0-9][0-9_]*(?![.eE]))[uU]?\\b"
        },
        {
          "name": "constant.numeric.float.paxsy",
          "match": "\\b([0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?|0x[0-9A-Fa-f][0-9A-Fa-f_]*\\.[0-9A-Fa-f][0-9A-Fa-f_]*([pP][+-]?[0-9][0-9_]*)?)[fF]?\\b"
        },
        {
          "name": "constant.numeric.float.paxsy",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*[fF]?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.paxsy",
          "match": "\\b(if|else|match|case|while|do|for|break|continue|return|defer|spawn|proc|pass)\\b"
        },
        {
          "name": "keyword.other.paxsy",
          "match": "\\b(let|func|comptime|use|module|extern|volatile|asm|alloc|free|try|catch|error|null|none|true|false|self)\\b"
        },
        {
          "name": "keyword.operator.logical.paxsy",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "storage.type.paxsy",
          "match": "\\b(Struct|Enum|Union)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.paxsy",
          "match": "\\b(Int8|Int16|Int32|Int64|Int128|Int256|UInt8|UInt16|UInt32|UInt64|UInt128|UInt256|Real32|Real64|UTF8|UTF16|UTF32|Bool|Void|Auto|Char|Int|UInt|Real|Thread)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.paxsy",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.paxsy",
          "match": "==|<>|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.assignment.paxsy",
          "match": "=|\\+=|-=|\\*=|/=|%=|\\$=|&=|\\^=|>>=|<<=|>>>=|<<<="
        },
        {
          "name": "keyword.operator.bitwise.paxsy",
          "match": "~|\\$|&|\\^|>>|<<|>>>|<<<"
        },
        {
          "name": "keyword.operator.range.paxsy",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.message.paxsy",
          "match": "<-"
        },
        {
          "name": "keyword.operator.address.paxsy",
          "match": "&|@"
        },
        {
          "name": "keyword.operator.type.paxsy",
          "match": "\\!|\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.paxsy",
          "match": "::|,|;|\\.|\\|"
        },
        {
          "name": "punctuation.bracket.paxsy",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
